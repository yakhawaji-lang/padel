+// swift-tools-version: 5.9
+// Enables Capacitor iOS apps using Swift Package Manager (CapApp-SPM) to link this plugin.
+import PackageDescription
+
+let package = Package(
+    name: "CapacitorCommunityContacts",
+    platforms: [.iOS(.v15)],
+    products: [
+        .library(
+            name: "CapacitorCommunityContacts",
+            targets: ["CapacitorCommunityContacts"])
+    ],
+    dependencies: [
+        .package(url: "https://github.com/ionic-team/capacitor-swift-pm.git", exact: "8.1.0")
+    ],
+    targets: [
+        .target(
+            name: "CapacitorCommunityContacts",
+            dependencies: [
+                .product(name: "Capacitor", package: "capacitor-swift-pm")
+            ],
+            path: "ios/Plugin",
+            exclude: ["Info.plist"],
+            publicHeadersPath: ".",
+            cSettings: [
+                .headerSearchPath(".")
+            ],
+            linkerSettings: [
+                .linkedFramework("Contacts"),
+                .linkedFramework("ContactsUI")
+            ]
+        )
+    ]
+)
