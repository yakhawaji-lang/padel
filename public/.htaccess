<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /
# Site root → SPA (prevents blank page when index.html at root is missing or wrong)
RewriteRule ^$ /app/ [R=302,L]
# SPA lives under /app — short links without /app (e.g. old WhatsApp) redirect here
RewriteRule ^pay-invite/(.*)$ /app/pay-invite/$1 [R=302,L]
RewriteRule ^pay-share/(.*)$ /app/pay-share/$1 [R=302,L]
# Don't rewrite files or directories
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
# Don't rewrite API requests
RewriteCond %{REQUEST_URI} !^/api/
# Rewrite everything else to index.html for SPA
RewriteRule ^ index.html [L]
</IfModule>
