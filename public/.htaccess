<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Apex / → SPA
RewriteRule ^$ /app/ [R=302,L]

# Short links (قديمة)
RewriteRule ^pay-invite/(.*)$ /app/pay-invite/$1 [R=302,L]
RewriteRule ^pay-share/(.*)$ /app/pay-share/$1 [R=302,L]

# لا تعيد كتابة /app إلى index.html في الجذر — يُخدم من مجلد app/ وملف app/.htaccess
RewriteCond %{REQUEST_URI} ^/app/ [OR]
RewriteCond %{REQUEST_URI} ^/app$
RewriteRule ^ - [L]

# API (إن وُجدت على نفس النطاق)
RewriteCond %{REQUEST_URI} ^/api/
RewriteRule ^ - [L]

# ملفات ومجلدات حقيقية
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# باقي المسارات غير /app → صفحة الجذر (تحويل أو لاحقاً SPA)
RewriteRule ^ index.html [L]
</IfModule>
